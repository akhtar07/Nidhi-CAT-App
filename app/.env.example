# Milestone 16 (SPEC.md §12 option B): copy this file to .env.local (gitignored) and fill in
# real values once a Supabase project exists — see PROGRESS.md's Milestone 16 setup steps.
# Both are safe to expose in the client bundle: the anon key only grants what Row Level
# Security allows (supabase/migrations/0001_init.sql), same as any other Supabase frontend app.
# Until these are set, the app runs exactly as it did before this milestone — IndexedDB only,
# no sync, no auth UI shown.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
